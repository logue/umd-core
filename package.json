  },
  "type": "module",
  "scripts": {
    "build": "./build.sh",
    "build:css": "rs build && node scripts/build-css.mjs",
    "dev:css": "rs dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "test": "cargo test",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && (npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m')"
  },
  "dependencies": {
    "@sableclient/twemoji-font": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsdoctor/cli": "^2.0.0",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspress/core": "^2.0.23",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-yml": "^3.9.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.5",
    "typescript": "^7.0.2"
  }
}
